# Runtime environment
NODE_ENV=production
LOG_LEVEL=info
MCP_SERVER_NAME=spigot-mcp
MCP_SERVER_VERSION=0.1.0

# MCP_TRANSPORT=stdio is for local desktop clients. For a remote Claude.ai
# connector, deploy with MCP_TRANSPORT=http over public HTTPS (TLS at a proxy).
MCP_TRANSPORT=stdio
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
# Required when HTTP_HOST is not a loopback address. Set your public hostname.
# HTTP_ALLOWED_HOSTS=mcp.example.com
# Optional comma-separated browser origins; Claude.ai's server-to-server calls do not require this.
# HTTP_CORS_ORIGINS=https://claude.ai

# Limits and outbound HTTP policy. No external calls are made by default.
MAX_INPUT_CHARS=10000
MAX_REQUEST_BYTES=1048576
EXTERNAL_API_TIMEOUT_MS=5000
EXTERNAL_API_RETRIES=2
EXTERNAL_API_RETRY_BASE_DELAY_MS=200
# Comma-separated hostnames allowed for future outbound integrations.
EXTERNAL_API_ALLOWED_HOSTS=
